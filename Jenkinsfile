pipeline{
agent any
stages{
  stage('checkout'){
    steps{
      echo 'checking the jenkins file'
    }}
stage('Build'){
    steps{
      echo 'building the code'
    }}
  stage('Test'){
    steps{
      echo 'testing the code'
    }}
  stage('package'){
    steps{
      echo 'creating the package'
    }}
}}
  
